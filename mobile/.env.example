# Backend API base URL (the client appends /api). Defaults to production if unset.
EXPO_PUBLIC_API_URL=https://api.gentrackai.com

# Google OAuth client IDs — create these in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# EXPO_PUBLIC_* variables are embedded in the client bundle at build time.
# OAuth *client* IDs are safe to expose publicly; never put client *secrets* here.
#
# Copy this file to `.env` and fill in the values.

# Required: OAuth 2.0 "Web application" client ID.
# Used to request an idToken (needed to verify the user on your backend) on every platform.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: OAuth 2.0 "iOS" client ID.
# Not required if you set `iosUrlScheme` in app.json or ship a GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK keys (RevenueCat dashboard → Project settings → API keys).
# These front StoreKit / Play Billing, which iOS and Android require for digital
# subscriptions (App Store guideline 3.1.1). Public keys are safe to embed; the
# secret key belongs to the backend (REVENUECAT_SECRET_KEY) and must never appear here.
# Without these, the native paywall cannot load prices or take a purchase.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Terms of Use (EULA) + Privacy Policy URLs. Apple requires a paywall for
# auto-renewable subscriptions to link to both; the links stay hidden while unset.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

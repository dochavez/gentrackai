APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gentrackai_api
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Base URL of the client app (used for password-reset links). Must be the
# HTTPS domain the mobile app claims via Universal Links / App Links so the
# emailed reset link (/reset-password) opens the app. In production this is the
# API domain that serves the /.well-known/* association files below.
FRONTEND_URL="${APP_URL}"

# Deep-link app-association identity (serves /.well-known/* for reset links).
# iOS: "<AppleTeamID>.<bundleId>", e.g. ABCDE12345.com.thotsuya.gentrackai
IOS_APP_ID=
# Android package + release signing SHA-256 fingerprint(s), comma-separated.
ANDROID_PACKAGE=com.thotsuya.gentrackai
ANDROID_SHA256_FINGERPRINTS=

# Google Sign-In — OAuth *client* IDs the app's ID token must be issued for.
# GOOGLE_CLIENT_ID is the Web client ID; GOOGLE_IOS_CLIENT_ID is optional.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Gemini (Google Generative Language) — reads generator nameplates via Prism.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Stripe billing (Laravel Cashier). Use TEST keys in dev. The publishable key
# (STRIPE_KEY, pk_...) is safe in the client; STRIPE_SECRET (sk_...) and
# STRIPE_WEBHOOK_SECRET (whsec_...) are server-only — NEVER commit live keys.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# The billable entity is the Organization (per-org plans), not the User.
CASHIER_MODEL="App\Models\Organization"
# Pro plan Stripe Price IDs (create the Product + Prices in the Stripe Dashboard).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Enforcement master switch — false = billing plumbing active but nobody is gated
# (ship this way pre-launch); true = enforce the Free/Pro limits below.
PLAN_ENFORCE=true
# Free-tier limits (Pro is unlimited). Blank/unset falls back to code defaults.
PLAN_FREE_GENERATORS=3
PLAN_FREE_MEMBERS=2
PLAN_FREE_CHAT_DAILY=5
# Where Stripe Checkout / billing portal returns the user afterwards.
STRIPE_CHECKOUT_SUCCESS_URL="${FRONTEND_URL}/billing?status=success"
STRIPE_CHECKOUT_CANCEL_URL="${FRONTEND_URL}/billing?status=cancel"
STRIPE_PORTAL_RETURN_URL="${FRONTEND_URL}/billing"

# RevenueCat (In-App Purchases). iOS must sell digital subscriptions with IAP
# (App Store guideline 3.1.1), so those purchases bypass Cashier entirely and
# land here instead. The SECRET key (sk_...) is server-only — the app uses the
# public SDK key. The webhook secret is the exact Authorization header value you
# set on the webhook in the RevenueCat dashboard (it does not sign payloads).
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifiers as configured in RevenueCat, mapped to our plans.
RC_ENTITLEMENT_PRO=pro
RC_ENTITLEMENT_TECHNICIAN=technician_pro

# Sign in with Apple — bundle identifiers accepted as the identity token's `aud`
# (comma-separated). Required by App Store guideline 4.8 alongside Google.
APPLE_BUNDLE_IDS=com.thotsuya.gentrackai

# Server credentials for Apple's OAuth endpoints, used to revoke a user's Apple
# grant when they delete their account (guideline 5.1.1(v)). From the Apple
# Developer portal: Membership > Team ID, and Keys > a key with "Sign in with
# Apple" enabled (download the .p8 once — it cannot be re-downloaded).
# APPLE_CLIENT_ID defaults to the first APPLE_BUNDLE_IDS entry.
# APPLE_PRIVATE_KEY takes either a path to the .p8 file or its contents with
# literal \n escapes. Leave blank and revocation is skipped; sign-in still works.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Require a technician to put a card on file before taking any work. Keep this
# false: on iOS the technician plan is an In-App Purchase, and capturing a card
# via Stripe Checkout is exactly what guideline 3.1.1 forbids.
TECH_REQUIRE_PAYMENT_METHOD=false
